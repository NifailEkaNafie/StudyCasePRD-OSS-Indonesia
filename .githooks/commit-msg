#!/usr/bin/env sh
# Git Hook: commit-msg
# Memvalidasi format Semantic Commit (Conventional Commits)

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

PATTERN="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\([a-zA-Z0-9_-]+\))?!?: .{3,100}$"

if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
  echo "❌ [ERROR] Pesan commit tidak sesuai format Semantic Commit!"
  echo "Format yang benar: <type>(<scope>): <deskripsi singkat>"
  echo "Contoh: feat(pdf-viewer): add in-app PDF preview for regulation files"
  echo "Type yang valid: feat, fix, docs, style, refactor, test, chore"
  exit 1
fi

exit 0
